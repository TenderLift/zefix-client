{
  "name": "@tenderlift/zefix-client",
  "version": "1.0.1",
  "description": "A zero-dependency, edge-compatible, and type-safe Zefix API client.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/TenderLift/zefix-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenderLift/zefix-client.git"
  },
  "bugs": {
    "url": "https://github.com/TenderLift/zefix-client/issues"
  },
  "keywords": [
    "zefix",
    "api",
    "client",
    "typescript",
    "edge",
    "cloudflare",
    "workers"
  ],
  "author": "TenderLift <support@tenderlift.ch>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./uid": {
      "types": "./dist/uid.d.ts",
      "import": "./dist/uid.js",
      "require": "./dist/uid.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "uid": [
        "./dist/uid.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "openapi-ts -f openapi-ts.config.ts",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "test": "pnpm test:node && pnpm test:workers && pnpm test:e2e",
    "test:node": "vitest run -c vitest.config.node.ts",
    "test:workers": "vitest run -c vitest.config.worker.ts",
    "test:e2e": "vitest run -c vitest.config.node.ts test/zefix-api.e2e.test.ts",
    "test:coverage": "vitest run -c vitest.config.node.ts --coverage",
    "test:types": "tsd",
    "test:watch": "vitest",
    "size": "size-limit",
    "analyze": "pnpm build && size-limit --why",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 KB"
    },
    {
      "path": "dist/uid.js",
      "limit": "1 KB"
    }
  ],
  "tsd": {
    "directory": "test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20260430.1",
    "@hey-api/openapi-ts": "^0.97.0",
    "@size-limit/file": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.6",
    "miniflare": "^4.20260430.0",
    "msw": "^2.14.2",
    "size-limit": "12.1.0",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "xo": "^1.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0"
}
